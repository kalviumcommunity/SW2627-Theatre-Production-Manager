rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isAuthenticated() {
      return request.auth != null;
    }

    function hasUserProfile() {
      return isAuthenticated()
        && exists(
          /databases/$(database)/documents/users/$(request.auth.uid)
        );
    }

    function isDirector() {
      return hasUserProfile()
        && get(
          /databases/$(database)/documents/users/$(request.auth.uid)
        ).data.role == 'Director';
    }

    match /users/{userId} {
      // Only allow users to read their own profile, protecting user emails from exposure.
      allow read: if isAuthenticated() && request.auth.uid == userId;

      // Public registration may create only a Cast Member profile for the caller's UID.
      allow create: if isAuthenticated()
        && request.auth.uid == userId
        && request.resource.data.role == 'Cast Member'
        && request.resource.data.name is string
        && request.resource.data.email is string;

      // Users may update their own profile, but cannot change their role.
      allow update: if isAuthenticated()
        && request.auth.uid == userId
        && request.resource.data.role == resource.data.role
        && request.resource.data
            .diff(resource.data)
            .affectedKeys()
            .hasOnly(['name', 'email'])
        && request.resource.data.name is string
        && request.resource.data.email is string;

      // Profile deletion is not available to ordinary clients.
      allow delete: if false;
    }

    match /productions/{productionId} {
      allow read: if isAuthenticated();

      allow create: if isDirector()
        && request.resource.data.title is string
        && request.resource.data.title.size() > 0
        && request.resource.data.status
          in ['Planning', 'In Rehearsal', 'Completed'];

      allow update: if isDirector()
        && request.resource.data.title is string
        && request.resource.data.title.size() > 0
        && request.resource.data.status
          in ['Planning', 'In Rehearsal', 'Completed'];

      allow delete: if isDirector();
    }

    match /rehearsals/{rehearsalId} {
      allow read: if isAuthenticated();

      allow create: if isDirector()
        && request.resource.data.productionId is string
        && request.resource.data.productionId.size() > 0
        && (
          (request.resource.data.venueId is string && request.resource.data.venueId.size() > 0)
          || (request.resource.data.venue is string && request.resource.data.venue.size() > 0)
        )
        && request.resource.data.startTime is timestamp
        && request.resource.data.endTime is timestamp
        && request.resource.data.endTime > request.resource.data.startTime;

      allow update: if isDirector()
        && request.resource.data.productionId is string
        && request.resource.data.productionId.size() > 0
        && (
          (request.resource.data.venueId is string && request.resource.data.venueId.size() > 0)
          || (request.resource.data.venue is string && request.resource.data.venue.size() > 0)
        )
        && request.resource.data.startTime is timestamp
        && request.resource.data.endTime is timestamp
        && request.resource.data.endTime > request.resource.data.startTime;

      allow delete: if isDirector();
    }

    match /auditions/{auditionId} {
      allow read: if isAuthenticated();

      allow create: if isDirector()
        && request.resource.data.productionId is string
        && request.resource.data.productionId.size() > 0
        && request.resource.data.title is string
        && request.resource.data.title.size() > 0
        && request.resource.data.venue is string
        && request.resource.data.venue.size() > 0
        && request.resource.data.startTime is timestamp
        && request.resource.data.endTime is timestamp
        && request.resource.data.endTime > request.resource.data.startTime
        && request.resource.data.status in ['Scheduled', 'Completed', 'Cancelled'];

      allow update: if isDirector()
        && request.resource.data.productionId is string
        && request.resource.data.productionId.size() > 0
        && request.resource.data.title is string
        && request.resource.data.title.size() > 0
        && request.resource.data.venue is string
        && request.resource.data.venue.size() > 0
        && request.resource.data.startTime is timestamp
        && request.resource.data.endTime is timestamp
        && request.resource.data.endTime > request.resource.data.startTime
        && request.resource.data.status in ['Scheduled', 'Completed', 'Cancelled'];

      allow delete: if isDirector();
    }

    match /venues/{venueId} {
      allow read: if isAuthenticated();

      allow create: if isDirector()
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.capacity is int
        && request.resource.data.capacity > 0;

      allow update: if isDirector()
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.capacity is int
        && request.resource.data.capacity > 0;

      allow delete: if isDirector();
    }

    match /cast_assignments/{assignmentId} {
      allow read: if isAuthenticated();

      allow create: if isDirector()
        && request.resource.data.productionId is string
        && request.resource.data.productionId.size() > 0
        && request.resource.data.userId is string
        && request.resource.data.userId.size() > 0
        && request.resource.data.characterRole is string
        && request.resource.data.characterRole.size() > 0
        && request.resource.data.actorName is string
        && request.resource.data.actorName.size() > 0
        && request.resource.data.status in ['Assigned', 'Confirmed', 'Understudy', 'Invited'];

      allow update: if isDirector()
        && request.resource.data.productionId is string
        && request.resource.data.productionId.size() > 0
        && request.resource.data.userId is string
        && request.resource.data.userId.size() > 0
        && request.resource.data.characterRole is string
        && request.resource.data.characterRole.size() > 0
        && request.resource.data.actorName is string
        && request.resource.data.actorName.size() > 0
        && request.resource.data.status in ['Assigned', 'Confirmed', 'Understudy', 'Invited'];

      allow delete: if isDirector();
    }

    match /cast_members/{memberId} {
      allow read: if isAuthenticated();
      allow create, update: if isAuthenticated() && (isDirector() || request.auth.uid == memberId);
      allow delete: if isDirector();
    }

    match /notifications/{notificationId} {
      allow read: if isAuthenticated();

      allow create: if isDirector();

      allow update: if isAuthenticated()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['read'])
        && request.resource.data.read is bool;

      allow delete: if isDirector();
    }

    match /user_tokens/{userId} {
      allow read, write: if isAuthenticated() && request.auth.uid == userId;
    }
  }
}
