rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }

    function getUserData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function isDirector() {
      return isAuthenticated() && 
        (getUserData().role == 'Director' || !exists(/databases/$(database)/documents/users/$(request.auth.uid)));
    }

    // User profiles collection
    match /users/{userId} {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated() && request.auth.uid == userId;
    }

    // Productions collection
    match /productions/{productionId} {
      // Any authenticated user (Director, Cast Member, Coordinator) can read productions
      allow read: if isAuthenticated();

      // Creating a production requires authentication, non-empty title, and valid status
      allow create: if isAuthenticated()
        && request.resource.data.title is string
        && request.resource.data.title.size() > 0
        && request.resource.data.status in ['Planning', 'In Rehearsal', 'Completed'];

      // Updating a production requires authentication, non-empty title, and valid status
      allow update: if isAuthenticated()
        && request.resource.data.title is string
        && request.resource.data.title.size() > 0
        && request.resource.data.status in ['Planning', 'In Rehearsal', 'Completed'];

      // Deleting a production requires authentication
      allow delete: if isAuthenticated();
    }
  }
}
